# here is the example of how to use kratos with env configurations
# for more details please check official kratos configurations docs https://www.ory.sh/docs/ecosystem/configuring

# Database connection
DSN=postgres://gk_circle:change_me_database_password@db:5432/kratos?sslmode=disable

# URLs
SERVE_PUBLIC_BASE_URL=http://localhost:4433
SERVE_ADMIN_BASE_URL=http://localhost:4434
SELFSERVICE_DEFAULT_BROWSER_RETURN_URL=http://localhost:3000
SELFSERVICE_ALLOWED_RETURN_URLS=http://localhost:3000

# UI URLs for flows
SELFSERVICE_FLOWS_ERROR_UI_URL=http://localhost:3000/error
SELFSERVICE_FLOWS_SETTINGS_UI_URL=http://localhost:3000/settings
SELFSERVICE_FLOWS_RECOVERY_UI_URL=http://localhost:3000/recovery
SELFSERVICE_FLOWS_VERIFICATION_UI_URL=http://localhost:3000/verification
SELFSERVICE_FLOWS_LOGIN_UI_URL=http://localhost:3000/account/login
SELFSERVICE_FLOWS_REGISTRATION_UI_URL=http://localhost:3000/account/register

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Secrets
SECRETS_COOKIE=change_me_to_a_long_random_cookie_secret
SECRETS_CIPHER=change_me_exactly_32_char_secret

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_LEAK_SENSITIVE_VALUES=false

# SMTP
# Local dev: Mailpit (no credentials needed)
COURIER_SMTP_CONNECTION_URI=smtp://mailpit:1025/?disable_starttls=true
COURIER_SMTP_FROM_ADDRESS=noreply@gkcircle.local

# Production (NUC .env only — never commit):
# COURIER_SMTP_CONNECTION_URI=smtps://resend:<URL_ENCODED_API_KEY>@smtp.resend.com:465/
# COURIER_SMTP_FROM_ADDRESS=account@<RESEND_SENDING_DOMAIN>

# Identity Schema
IDENTITY_DEFAULT_SCHEMA_ID=default
IDENTITY_SCHEMAS_URL=file:///etc/config/kratos/identity.schema.json

# Cookie Settings
COOKIES_DOMAIN=localhost
COOKIES_PATH=/
COOKIES_SAME_SITE=Lax
