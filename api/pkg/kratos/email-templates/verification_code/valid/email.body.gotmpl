<!-- GK Circle Email Template: verification_code v1 -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>Verify your GK Circle email address</title>
</head>
<body style="margin:0;padding:0;background-color:#fdfbf7;font-family:Arial,Helvetica,sans-serif;font-size:16px;color:#2d2d2d;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="100%" style="max-width:560px;" cellspacing="0" cellpadding="0" border="0">

          <!-- Logo -->
          <tr>
            <td align="center" style="padding-bottom:32px;">
              <img
                src="https://gkcircle.com/brand/gk-circle-wordmark.png"
                width="180"
                height="48"
                alt="GK Circle"
                style="display:block;border:0;max-width:100%;height:auto;"
              >
            </td>
          </tr>

          <!-- Card -->
          <tr>
            <td style="background-color:#ffffff;border:2px solid #2d2d2d;padding:40px 36px;">

              <h1 style="margin:0 0 16px 0;font-family:Arial,Helvetica,sans-serif;font-size:22px;font-weight:700;color:#2d2d2d;line-height:1.3;">
                Verify your email address
              </h1>

              <p style="margin:0 0 24px 0;line-height:1.6;color:#2d2d2d;">
                Use the code below to verify your email address and activate your GK Circle account.
              </p>

              <!-- OTP Code block -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td align="center" style="padding:24px 0;">
                    <div style="display:inline-block;background-color:#fde047;border:2px solid #2d2d2d;padding:16px 32px;">
                      <span style="font-family:Arial,Helvetica,sans-serif;font-size:32px;font-weight:700;letter-spacing:8px;color:#2d2d2d;">{{ .VerificationCode }}</span>
                    </div>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 24px 0;line-height:1.6;color:#2d2d2d;">
                You can also verify by clicking the link below:
              </p>

              <!-- CTA Button -->
              <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td style="background-color:#fde047;border:2px solid #2d2d2d;">
                    <a href="{{ .VerificationURL }}"
                       style="display:inline-block;padding:14px 28px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:700;color:#2d2d2d;text-decoration:none;min-height:44px;line-height:16px;">
                      Verify email address
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Plain-text URL fallback -->
              <p style="margin:24px 0 0 0;font-size:13px;color:#2d2d2d;word-break:break-all;">
                Or copy this link into your browser:<br>
                <span style="color:#2d2d2d;">{{ .VerificationURL }}</span>
              </p>

              <!-- Expiry notice -->
              <p style="margin:24px 0 0 0;font-size:14px;line-height:1.6;color:#2d2d2d;border-top:1px solid #e5e5e5;padding-top:20px;">
                For your security, this code is valid for a limited time. If it has expired, return to GK Circle and request a new one.
              </p>

              <!-- Security notice -->
              <p style="margin:16px 0 0 0;font-size:14px;line-height:1.6;color:#2d2d2d;">
                If you did not create a GK Circle account, you can safely ignore this email. No changes will be made.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:28px 0 0 0;text-align:center;font-size:13px;color:#2d2d2d;line-height:1.8;">
              GK Circle &middot; <a href="https://gkcircle.com" style="color:#2d2d2d;">gkcircle.com</a> &middot; <a href="mailto:support@gkcircle.com" style="color:#2d2d2d;">support@gkcircle.com</a>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
