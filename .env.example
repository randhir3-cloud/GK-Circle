# ============================================================
# GK Circle - local development environment template
# Copy to .env, replace every change_me value, then run docker compose up.
# Never commit the generated .env file.
# ============================================================

# ── API (Go Backend) ──────────────────────────────────────
IS_DEVELOPMENT=true
DEBUG=true
APP_PORT=0.0.0.0:3000
APP_ENV=local

# ── Database ──────────────────────────────────────────────
DB_DIALECT=postgres
DB_HOST=db
DB_PORT=5432
DB_USERNAME=jovvix
DB_PASSWORD=change_me_database_password
DB_NAME=jovvix
DB_QUERYSTRING=sslmode=disable
MIGRATION_DIR=database/migrations

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
ISSUER=gk-circle.local

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379
REDIS_DATABASES=0

# ── Ory Kratos ────────────────────────────────────────────
KRATOS_ENABLED=true
KRATOS_COOKIE_EXPIRATION_TIME=2h23m
SERVE_PUBLIC_BASE_URL=http://kratos:4433
SERVE_PUBLIC_HOST=kratos
SERVE_PUBLIC_PORT=4433

# ── MinIO ─────────────────────────────────────────────────
MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_minio_password

# ── Frontend (Nuxt 3) ─────────────────────────────────────
# URL visible from browser (host machine)
NUXT_PUBLIC_API_URL=http://localhost:3010/api/v1
NUXT_PUBLIC_API_SOCKET_URL=ws://localhost:3010/api/v1/socket
NUXT_PUBLIC_KRATOS_URL=http://localhost:4433

# ── pgAdmin (optional --profile tools) ───────────────────
PGADMIN_EMAIL=admin@gk-circle.local
PGADMIN_PASSWORD=change_me_pgadmin_password
PGADMIN_PORT=5051
